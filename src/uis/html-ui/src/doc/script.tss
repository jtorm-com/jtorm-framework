script {
    ->if(d: async)
    ->attr {
        n: 'async';
        v: true;
    }

    ->attr {
        n: 'charset';
        v: charset;
    }

    ->if(d: defer)
    ->attr {
        n: 'defer';
        v: true;
    }

    ->attr {
        n: 'src';
        v: src;
    }

    ->attr {
        n: 'type';
        v: type;
    }

    // raw-text element — content (JS) serializes verbatim; raw slot, not replacable.
    ->get {
        t: '@h/rawcontent.tss';
    }
}

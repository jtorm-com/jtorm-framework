link {
    ->attr {
        n: 'crossorigin';
        v: crossorigin;
    }

    ->attr {
        n: 'rel';
        v: rel;
    }

    ->attr {
        n: 'sizes';
        v: sizes;
    }

    ->get {
        t: '@h/linkable.tss';
    }
}

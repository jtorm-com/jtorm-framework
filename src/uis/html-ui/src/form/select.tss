select {
    ->inner {
        h: html;
    }

    ->if(d: multiple)
    ->attr {
        n: 'multiple';
        v: true;
    }

    ->if(d: required)
    ->attr {
        n: 'required';
        v: true;
    }

    ->if(d: size, v: '^[0-9]+$', r: true)
    ->attr {
        n: 'size';
        v: size;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}

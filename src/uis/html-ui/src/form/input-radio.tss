input {
  ->attr {
    n: 'type';
    v: 'radio';
  }
  ->if {
    d: checked;
    ->attr {
      n: 'checked';
      v: true;
    }
  }
  ->if {
    d: required;
    ->attr {
      n: 'required';
      v: required;
    }
  }
  ->get {
    t: '@h/form/form-element.tss';
  }
}
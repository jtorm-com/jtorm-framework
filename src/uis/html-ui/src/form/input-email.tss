/*! (c) jTorm and other contributors | www.jtorm.com/license */
input {
    ->attr {
        n: 'type';
        v: 'email';
    }

    ->if(d: autocomplete, v: '^(on|off)$')->attr {
        n: 'autocomplete';
        v: autocomplete;
    }

    ->attr {
        n: 'list';
        v: list;
    }

    ->if(d: multiple)->attr {
        n: 'multiple';
        v: true;
    }

    ->attr {
        n: 'pattern';
        v: pattern;
    }

    ->get {
        t: '@h/form/input.tss';
    }
}
textarea {
    ->inner {
        h: html;
    }

    ->if(d: cols, v: '^[0-9]+$', r: true)
    ->attr {
        n: 'cols';
        v: cols;
    }

    ->attr {
        n: 'dirname';
        v: dirname;
    }

    ->if(d: readonly)
    ->attr {
        n: 'readonly';
        v: true;
    }

    ->if(d: maxlength, v: '^[0-9]+$', r: true)
    ->attr {
        n: 'maxlength';
        v: maxlength;
    }

    ->if(d: required)
    ->attr {
        n: 'required';
        v: true;
    }

    ->attr {
        n: 'placeholder';
        v: placeholder;
    }

    ->if(d: rows, v: '^[0-9]+$', r: true)
    ->attr {
        n: 'rows';
        v: rows;
    }

    ->if(d: wrap, v: '^(hard|soft)$', r: true)
    ->attr {
        n: 'wrap';
        v: wrap;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}

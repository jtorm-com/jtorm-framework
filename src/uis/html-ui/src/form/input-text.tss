/*! (c) jTorm and other contributors | www.jtorm.com/license */

input {
    ->attr {
        n: 'type';
        v: 'text';
    }

    ->if(d: autocomplete, v: '^(on|off)$')
    ->attr {
        n: 'autocomplete';
        v: autocomplete;
    }

    ->attr {
        n: 'list';
        v: list;
    }

    ->if(d: dirname) {
        ->attr {
            n: 'dirname';
            v: name;
        }

        ->attr {
            n: 'dirname';
            v: '.dir';
            m: 'a';
            ns: true;
        }
    }

    ->attr {
        n: 'pattern';
        v: pattern;
    }

    ->if(d: size, v: '^[0-9]+$')
    ->attr {
        n: 'size';
        v: size;
    }

    ->if(d: readonly)
    ->attr {
        n: 'readonly';
        v: true;
    }

    ->if(d: minlength, v: '^[0-9]+$')
    ->attr {
        n: 'minlength';
        v: minlength;
    }

    ->if(d: maxlength, v: '^[0-9]+$')
    ->attr {
        n: 'maxlength';
        v: maxlength;
    }

    ->if(d: required)
    ->attr {
        n: 'required';
        v: true;
    }

    ->attr {
        n: 'placeholder';
        v: placeholder;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}

fieldset {
  ->if {
    d: disabled;
    ->attr {
      n: 'disabled';
      v: true;
    }
  }
  ->if {
    d: form;
    ->attr {
      n: 'form';
      v: form;
    }
  }
  ->if {
    d: name;
    ->attr {
      n: 'name';
      v: name;
    }
  }
  ->get {
    t: '@h/replacable.tss';
  }
}
input {
    ->attr {
        n: 'type';
        v: 'checkbox';
    }

    ->if(d: checked)
    ->attr {
        n: 'checked';
        v: true;
    }

    ->if(d: required)
    ->attr {
        n: 'required';
        v: true;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}

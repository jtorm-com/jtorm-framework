datalist {
    ->if(d: items)->each {
        d: items;
        m: 'append';

        ->ui {
            c: 'form.option';

            option->attr {
                n: 'value';
                v: value;
            }

            option->inner{
                h: label;
            }
        }
    }

    ->get {
        t: '@h/replacable.tss';
    }
}

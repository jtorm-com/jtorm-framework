datalist {
    ->if(d: items)
    ->each {
        d: items;

        ->ui {
            c: 'form.option';

            option
                ->attr(
                    n: 'value';
                    v: value;
                )
                ->inner {
                    t: label;
                }
        }
    }

    ->get {
        t: '@h/replacable.tss';
    }
}

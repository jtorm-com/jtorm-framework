input {
    ->attr {
        n: 'type';
        v: 'password';
    }

    ->attr {
        n: 'autocomplete';
        v: 'off';
    }

    ->attr {
        n: 'pattern';
        v: pattern;
    }

    ->get {
        t: '@h/form/input.tss';
    }
}
/*! (c) jTorm and other contributors | www.jtorm.com/license */
input {
    ->if(d: type, v: '^(button|checkbox|color|date|datetime-local|email|file|hidden|image|month|number|password|radio|range|reset|search|submit|tel|text|time|url|week)$')->attr {
        n: 'type';
        v: type;
    }

    ->attr {
        n: 'dirname';
        v: dirname;
    }

    ->attr {
        n: 'pattern';
        v: pattern;
    }

    ->if(d: size, v: '^[0-9]+$')->attr {
        n: 'size';
        v: size;
    }

    ->if(d: readonly)->attr {
        n: 'readonly';
        v: true;
    }

    ->if(d: minlength, v: '^[0-9]+$')->attr {
        n: 'minlength';
        v: true;
    }

    ->if(d: maxlength, v: '^[0-9]+$')->attr {
        n: 'maxlength';
        v: true;
    }

    ->if(d: required)->attr {
        n: 'required';
        v: true;
    }

    ->attr {
        n: 'placeholder';
        v: placeholder;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}
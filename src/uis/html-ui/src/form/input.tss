// `input {…}` is intentional: this file is ALSO a get-target (input-email.tss etc. ->get it),
// so under the component's resolved <input> ancestor element these rules match the <input>
// itself (document-model.scope: descendant-first → else self — no same-tag descendant exists).
// Do NOT "consistency-fix" it to selectorless — that changes its standalone behaviour. See AGENTS.md.
input {
    //->if(d: type, v: '^(button|checkbox|color|date|datetime-local|email|file|hidden|image|month|number|password|radio|range|reset|search|submit|tel|text|time|url|week)$')
    ->attr {
        n: 'type';
        v: type;
    }

    ->attr {
        n: 'dirname';
        v: dirname;
    }

    ->attr {
        n: 'pattern';
        v: pattern;
    }

    ->if(
        d: size,
        v: '^[0-9]+$',
        r: true
    )
    ->attr {
        n: 'size';
        v: size;
    }

    ->if(d: readonly)
    ->attr {
        n: 'readonly';
        v: true;
    }

    ->if(
        d: minlength,
        v: '^[0-9]+$',
        r: true)
    ->attr {
        n: 'minlength';
        v: minlength;
    }

    ->if(
        d: maxlength,
        v: '^[0-9]+$',
        r: true
    )
    ->attr {
        n: 'maxlength';
        v: maxlength;
    }

    ->if(d: required)
    ->attr {
        n: 'required';
        v: true;
    }

    ->attr {
        n: 'placeholder';
        v: placeholder;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}

input {
    ->attr {
        n: 'type';
        v: 'color';
    }

    ->attr {
        n: 'list';
        v: list;
    }

    ->if(d: autocomplete, v: '^(on|off)$', r: true)
    ->attr {
        n: 'autocomplete';
        v: autocomplete;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}

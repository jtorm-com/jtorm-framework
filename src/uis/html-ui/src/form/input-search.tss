input {
    ->attr {
        n: 'type';
        v: 'search';
    }

    ->if(
        d: autocomplete,
        v: '^(on|off)$',
        r: true
    )
    ->attr {
        n: 'autocomplete';
        v: autocomplete;
    }

    ->attr {
        n: 'list';
        v: list;
    }

    ->attr {
        n: 'pattern';
        v: pattern;
    }

    ->get {
        t: '@h/form/input.tss';
    }
}

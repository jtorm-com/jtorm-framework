input {
  ->attr {
    n: 'type';
    v: 'file';
  }
  ->if {
    d: accept;
    ->attr {
      n: 'accept';
      v: accept;
    }
  }
  ->if {
    d: multiple;
    ->attr {
      n: 'multiple';
      v: true;
    }
  }
  ->get {

input {
    ->attr {
        n: 'type';
        v: 'file';
    }

    ->attr {
        n: 'accept';
        v: accept;
    }

    ->if(d: multiple)
    ->attr {
        n: 'multiple';
        v: true;
    }

    ->get {
        t: '@h/form/form-element.tss';
    }
}

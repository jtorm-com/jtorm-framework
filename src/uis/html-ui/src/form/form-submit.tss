->attr {
  n: 'formaction';
  v: formaction;
}
->if {
  d: formenctype;
  v: '^(application\/x-www-form-urlencoded|multipart\/form-data|text\/plain)$';
  ->attr {
    n: 'formenctype';
    v: formenctype;
  }
}
->if {
  d: formmethod;
  v: '^(get|post)$';
  ->attr {
    n: 'formmethod';
    v: formmethod;
  }
}
->attr {
  n: 'formtarget';
  v: formtarget;
}
->if(d: formnovalidate)->attr {
  n: 'formnovalidate';
  v: true;
}
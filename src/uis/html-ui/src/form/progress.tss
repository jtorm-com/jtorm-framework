progress {
    ->if(d: max, v: '^[0-9]+(.[0-9])?$')->attr {
        n: 'max';
        v: max;
    }

    ->if(d: value, v: '^[0-9]+(.[0-9])?$')->attr {
        n: 'value';
        v: value;
    }

    ->get {
        t: '@h/replacable.tss';
    }
}
form {
    ->attr {
        n: 'accept-charset';
        v: accept-charset;
    }

    ->attr {
        n: 'action';
        v: action;
    }

    ->if(d: autocomplete, v: '^(on|off)$', r: true)
    ->attr {
        n: 'autocomplete';
        v: autocomplete;
    }

    ->if(d: enctype, v: '^(application\/x-www-form-urlencoded|multipart\/form-data|text\/plain)$', r: true)
    ->attr {
        n: 'enctype';
        v: enctype;
    }

    ->if(d: method, v: '^(get|post)$', r: true)
    ->attr {
        n: 'method';
        v: method;
    }

    ->attr {
        n: 'name';
        v: name;
    }

    ->if(d: novalidate)
    ->attr {
        n: 'novalidate';
        v: true;
    }

    ->attr {
        n: 'target';
        v: target;
    }

    ->get {
        t: '@h/replacable.tss';
    }
}

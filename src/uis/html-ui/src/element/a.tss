a {
    ->inner {
        t: html;
    }

    ->attr {
        n: 'download';
        v: download;
    }

    ->attr {
        n: 'ping';
        v: ping;
    }

    ->if(d: referrerpolicy, v: '^(no-referrer|no-referrer-when-downgrade|origin|origin-when-cross-origin|unsafe-url)$', r: true)
    ->attr {
        n: 'referrerpolicy';
        v: referrerpolicy;
    }

    ->if(d: rel, v: '^(alternate|author|bookmark|help|license|next|nofollow|noreferrer|prefetch|prev|search|tag)$', r: true)
    ->attr {
        n: 'rel';
        v: rel;
    }

    ->attr {
        n: 'target';
        v: target;
    }

    ->get {
        t: '@h/linkable.tss';
    }
}

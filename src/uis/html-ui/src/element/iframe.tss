iframe {
    ->if(d: height, v: '^[0-9]+$', r: true)
    ->attr {
        n: 'height';
        v: height;
    }

    ->attr {
        n: 'name';
        v: name;
    }

    ->if(d: sandbox, v: '^(allow-forms|allow-pointer-lock|allow-popups|allow-same-origin|allow-scripts|allow-top-navigation)$', r: true)
    ->attr {
        n: 'sandbox';
        v: sandbox;
    }

    ->attr {
        n: 'src';
        v: src;
    }

    ->attr {
        n: 'srcdoc';
        v: srcdoc;
    }

    ->if(d: width, v: '^[0-9]+$', r: true)
    ->attr {
        n: 'width';
        v: width;
    }

    // raw-text element — fallback content serializes verbatim; raw slot, not replacable.
    ->get {
        t: '@h/rawcontent.tss';
    }
}

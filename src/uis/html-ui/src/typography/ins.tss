ins {
  ->if {
    d: datetime;
    v: '^[0-9]{4}-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-6][0-9]:[0-6][0-9][+-][0-9]{2}:[0-9]{2}$';
    ->attr {
      n: 'datetime';
      v: datetime;
    }
  }
  ->get {
    t: '@h/typo/citable.tss';
  }
}
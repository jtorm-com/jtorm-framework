area {
  ->if {
    d: alt;
    ->attr {
      n: 'alt';
      v: alt;
    }
  }
  ->if {
    d: coords;
    ->attr {
      n: 'coords';
      v: coords;
    }
  }
  ->if {
    d: shape;
    ->attr {
      n: 'shape';
      v: shape;
    }
  }
  ->get {
    t: '@h/linkable.tss';
  }
}
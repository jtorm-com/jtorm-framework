canvas {
  ->if {
    d: width;
    v: '^[0-9]+$';
    ->attr {
      n: 'width';
      v: width;
    }
  }
  ->if {
    d: height;
    v: '^[0-9]+$';
    ->attr {
      n: 'height';
      v: height;
    }
  }
  ->get {
    t: '@h/replacable.tss';
  }
}
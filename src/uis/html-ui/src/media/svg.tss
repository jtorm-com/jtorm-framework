svg {
  ->if {
    d: width;
    v: '^[0-9]+$';
    ->attr {
      n: 'width';
      v: width;
    }
  }
  ->if {
    d: height;
    v: '^[0-9]+$';
    ->attr {
      n: 'height';
      v: height;
    }
  }
  ->attr {
    n: 'xmlns';
    v: 'http://www.w3.org/2000/svg';
  }
  ->get {
    t: '@h/replacable.tss';
  }
}
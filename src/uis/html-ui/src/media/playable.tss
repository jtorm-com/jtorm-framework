->if(d: autoplay)->attr {
    n: 'autoplay';
    v: true;
}

->if(d: controls)->attr {
    n: 'controls';
    v: true;
}

->if(d: loop)->attr {
    n: 'loop';
    v: true;
}

->if(d: muted)->attr {
    n: 'muted';
    v: true;
}

->if(d: preload, v: '^(auto|metadata|none)$')->attr {
    n: 'preload';
    v: preload;
}

->attr {
    n: 'src';
    v: src;
}

->get {
    t: '@h/replacable.tss';
}

->if(d: autoplay)
->attr {
    n: 'autoplay';
    v: true;
}

->if(d: controls)
->attr {
    n: 'controls';
    v: true;
}

->if(d: loop)
->attr {
    n: 'loop';
    v: true;
}

->if(d: muted)
->attr {
    n: 'muted';
    v: true;
}

->if(d: preload, v: '^(auto|metadata|none)$', r: true)
->attr {
    n: 'preload';
    v: preload;
}

->attr {
    n: 'src';
    v: src;
}

// RAW content: audio/video compose child <source>/<track> markup — the raw slot
// (NOT replacable's escaped t:). Carries the shared global attrs too.
->get {
    t: '@h/rawcontent.tss';
}

td {
  ->if {
    d: colspan;
    v: '^[0-9]+$';
    ->attr {
      n: 'colspan';
      v: colspan;
    }
  }
  ->if {
    d: headers;
    ->attr {
      n: 'headers';
      v: headers;
    }
  }
  ->get {
    t: '@h/replacable.tss';
  }
}
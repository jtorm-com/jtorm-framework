head {
  ->append(d: fb) {
    ->if(d: profile_id)->append->ui {
      c: 'doc.meta';
      t: 0;
      meta->attrs {
        n: 'property,content';
        v: 'fb:profile_id,profile_id';
      }
    }
    ->if(d: page_id)->append->ui {
      c: 'doc.meta';
      t: 0;
      meta->attrs {
        n: 'property,content';
        v: 'fb:page_id,page_id';
      }
    }
    ->if(d: app_id)->append->ui {
      c: 'doc.meta';
      t: 0;
      meta->attrs {
        n: 'property,content';
        v: 'fb:app_id,app_id';
      }
    }
    ->if(d: admins)->append->ui {
      c: 'doc.meta';
      t: 0;
      meta->attrs {
        n: 'property,content';
        v: 'fb:admins,admins';
      }
    }
  }
}
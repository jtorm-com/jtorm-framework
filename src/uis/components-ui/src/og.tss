head->append(d: og) {
  ->append->ui {
    c: 'doc.meta';
    t: '0';
    meta->attrs {
      n: 'property,content';
      v: 'og:locale,locale';
    }
  }
  ->append->ui {
    c: 'doc.meta';
    t: '0';
    meta->attrs {
      n: 'property,content';
      v: 'og:site_name,site_name';
    }
  }
  ->append->ui {
    c: 'doc.meta';
    t: '0';
    meta->attrs {
      n: 'property,content';
      v: 'og:type,type';
    }
  }
  ->append->ui {
    c: 'doc.meta';
    t: '0';
    meta->attrs {
      n: 'property,content';
      v: 'og:url,url';
    }
  }
  ->append->ui {
    c: 'doc.meta';
    t: '0';
    meta->attrs {
      n: 'property,content';
      v: 'og:title,title';
    }
  }
  ->append->ui {
    c: 'doc.meta';
    t: '0';
    meta->attrs {
      n: 'property,content';
      v: 'og:description,description';
    }
  }
  ->if(d: images)->each {
    d: images;
    m: 'append';
    ->append->ui {
      c: 'doc.meta';
      t: '0';
      meta->attrs {
        n: 'property,content';
        v: 'og:image,url';
      }
    }
    ->if(d: width)->append->ui {
      c: 'doc.meta';
      t: '0';
      meta->attrs {
        n: 'property,content';
        v: 'og:image:width,width';
      }
    }
    ->if(d: height)->append->ui {
      c: 'doc.meta';
      t: '0';
      meta->attrs {
        n: 'property,content';
        v: 'og:image:height,height';
      }
    }
  }
}
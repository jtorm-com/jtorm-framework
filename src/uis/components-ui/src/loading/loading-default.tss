->data(id: 'loading')
->ui {
    c: '@e.div';

    div {
        ->attr {
            n: 'data-nosnippet';
            v: '1';
            m: 'a';
        }

        ->append
        ->ui {
            c: '@e.div';
            t: '0';

            div {
                ->append->ui {
                    c: '@e.span';
                    t: '0';
                }

                ->append
                ->ui {
                    c: '@t.small';
                    t: '0';

                    small
                        ->text(label: 'Loading')
                        ->inner {
                            t: label;
                        }
                }
            }
        }
    }
}

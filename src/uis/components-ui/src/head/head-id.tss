->data(name: 'description', content: disambiguatingDescription.Text)->append->ui {
    c: 'doc.meta';
}

->if(d: url)->data(rel: 'canonical', href: url)->append->ui {
    c: 'doc.link';
}

->data(h: url)->append->ui {
    c: 'doc.link';
    t: '0';

    link {
        ->attrs {
            n: 'rel,type';
            v: 'alternate,application/ld+json';
        }

        ->attr {
            n: 'href';
            v: h;
            a: '.jsonld';
        }
    }
}

->if(d: workTranslation)->each {
    m: 'append';
    d: workTranslation;

    ->data(rel: 'alternate', hreflang: inLanguage, href: url)
    ->ui {
        c: 'doc.link';
    }
}

->data(name: 'robots', content: @meta.robots||'index, follow')->append->ui {
    c: 'doc.meta';
}

->data(name: 'referrer', content: @meta.referrer||'origin')->append->ui {
    c: 'doc.meta';
}

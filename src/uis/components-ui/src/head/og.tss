/*! (c) jTorm and other contributors | www.jtorm.com/license */

->if(d: locale)
->data(
    property: 'og:locale',
    content: locale
)
->append
->ui {
    c: 'doc.meta';
}

->if(d: site_name)
->data(
    property: 'og:site_name',
    content: site_name
)
->append
->ui {
    c: 'doc.meta';
}

->if(d: type)
->data(
    property: 'og:type',
    content: type
)
->append
->ui {
    c: 'doc.meta';
}

->if(d: url)
->data(
    property: 'og:url',
    content: url
)
->append
->ui {
    c: 'doc.meta';
}

->if(d: title)
->data(
    property: 'og:title',
    content: title
)
->append
->ui {
    c: 'doc.meta';
}

->if(d: description)
->data(
    property: 'og:description',
    content: description
)
->append
->ui {
    c: 'doc.meta';
}

->if(d: images)
->each {
    d: images;

    ->data(
        property: 'og:image',
        content: url
    )
    ->append
    ->ui {
        c: 'doc.meta';
    }

    ->if(d: width)
    ->data(
        property: 'og:image:width',
        content: width
    )
    ->append
    ->ui {
        c: 'doc.meta';
    }

    ->if(d: height)
    ->data(
        property: 'og:image:height',
        content: height
    )
    ->append
    ->ui {
        c: 'doc.meta';
    }
}

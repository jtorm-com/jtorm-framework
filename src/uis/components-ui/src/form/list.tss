->ui {
  c: "list";
  ul->attr {
    n: "role";
    v: "listbox";
  }
  li->each {
    d: items;
    e: "li";
    m: "replace";
    li->wrap {
      s: "label";
      d: item;
      ->ui {
        c: "form.label";
        t: 0;
        label->attr {
          n: "role";
          v: "option";
        }
      }
    }
  }
}
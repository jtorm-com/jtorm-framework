->title {
    t: name.Text;
}

html->attr {
    n: 'lang';
    v: mainEntity.@c.inLanguage.Text;
}

head {
    ->data(@facebook)->get {
        t: '@c/facebook.tss';
    }

    ->data(@twitter)->get {
        t: '@c/twitter.tss';
    }

    ->data(@google)->get {
        t: '@c/google.tss';
    }

    ->data(@config.og)->get {
        t: '@c/og.tss';
    }
}
->ui {
  c: '@e.nav';
  nav->append->ui {
    c: 'list.ul';
    li->each {
      d: items;
      e: 'li';
      m: 'replace';
      li->wrap {
        s: 'a';
        d: anchor;
        ->ui {
          c: '@e.a';
        }
      }
    }
  }
}
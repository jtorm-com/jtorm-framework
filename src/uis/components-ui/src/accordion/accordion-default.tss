->if(to: 'array') {
    ->else
    ->if(to: 'object')
    ->if(
        d: items,
        to: 'array'
    ) {
        ->get {
            t: '@c/accordion/accordion-group.tss';
        }

        .jtorm-accordion:last-child {
            ->each(
                d: items,
                a: 'item'
            )
            ->data(
                summary: item.summary,
                content: item.content,
                open: item.open,
                id: item.id,
                class: item.class,
                lang: item.lang,
                dir: item.dir
            ) {
                body
                    ->append
                    ->ui {
                        c: 'accordion.item';
                    }
            }
        }
    }
}

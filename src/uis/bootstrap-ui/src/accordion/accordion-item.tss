->if(to: 'array') {
    ->else
    ->if(to: 'object')
    ->if(
        d: summary,
        to: 'string'
    )
    ->if(
        d: content,
        to: 'string'
    ) {
        .jtorm-accordion__item:last-child:not(.accordion-item)
        ->if(el: '.jtorm-accordion__item:last-child:not(.accordion-item)')
        ->attr {
            n: 'class';
            v: 'accordion-item';
            m: 'a';
        }

        .jtorm-accordion__item:last-child {
            .jtorm-accordion__summary:not(.accordion-header)
            ->if(el: '.jtorm-accordion__summary:not(.accordion-header)')
            ->attr {
                n: 'class';
                v: 'accordion-header p-3 fw-semibold';
                m: 'a';
            }

            .jtorm-accordion__content:not(.accordion-body)
            ->if(el: '.jtorm-accordion__content:not(.accordion-body)')
            ->attr {
                n: 'class';
                v: 'accordion-body';
                m: 'a';
            }
        }
    }
}

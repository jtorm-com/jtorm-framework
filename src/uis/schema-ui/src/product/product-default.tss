.thing->attr {
    n: 'class';
    v: 'product';
    m: 'a';
}

.body
    ->if(d: sku) {
        ->data(skuLabel: 'SKU')
        ->text(skuLabel: skuLabel)
        ->data(html: ' ' + skuLabel + ': ' + sku)
        ->append
        ->ui {
            c: '@e.span';

            span->attr {
                n: 'class';
                v: 'sku';
            }
        }
    }

.body
    ->if(d: gtin) {
        ->data(gtinLabel: 'GTIN')
        ->text(gtinLabel: gtinLabel)
        ->data(html: ' ' + gtinLabel + ': ' + gtin)
        ->append
        ->ui {
            c: '@e.span';

            span->attr {
                n: 'class';
                v: 'gtin';
            }
        }
    }

.body
    ->if(d: brand.name)
    ->data(
        href: brand.url,
        Text: ' ' + brand.name
    )
    ->append
    ->ui {
        c: '@e.span';

        span {
            ->attr {
                n: 'class';
                v: 'product-brand';
            }

            ->if(d: href) {
                ->data(title: brand.name) {
                    ->ui {
                        c: '@e.a';

                        a->ui {
                            c: 'Text';
                        }
                    }
                }

                ->else
                ->ui {
                    c: 'Text';
                }
            }
        }
    }

.body
    ->if(d: offers)
    ->append
    ->each(
        d: offers,
        a: 'offer'
    )
    ->data(
        price: offer.price,
        priceCurrency: offer.priceCurrency,
        availability: offer.availability,
        url: offer.url
    ) {
        body->ui {
            c: 'Offer';
        }
    }

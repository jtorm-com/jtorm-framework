->ui {
    c: '@e.nav';
    t: '0';

    nav {
        ->attrs {
            n: 'id,aria-label';
            v: 'breadcrumbs,Breadcrumbs';
        }

        ->append
        ->ui {
            c: 'contents';

            .contents {
                ->text(html: 'You are here')
                ->append
                ->ui {
                    c: '@e.span';
                    t: '0';

                    span->append {
                        t: html + ': ';
                    }
                }

                ->append
                ->ui {
                    c: '@t.ol';
                    t: '0';

                    ol
                        ->each(d: itemListElement)
                        ->get(d: @id) {
                            body
                                ->append
                                ->ui {
                                    c: '@t.li';
                                    t: '0';

                                    li
                                        ->get(d: item.@id)
                                        ->ui {
                                            c: 'Thing.link';
                                        }
                                }
                        }
                }
            }
        }
    }
}

->ui {
    c: '@e.header';
    t: '0';

    header
        ->attr(
            n: 'class',
            v: 'w-p-header'
        )
        ->append
        ->ui {
            c: 'WebPageElement.contents';

            body > .contents > .header
                ->swap {
                    s: 'section';
                    ui: '@e.section';
                    a: '1';
                }

            body > .contents > .image
                ->move {
                    l: 'body > .contents > .header';
                    m: 'prepend';
                }

            body > .contents > .footer
                ->swap {
                    s: 'section';
                    ui: '@e.section';
                    a: '1';
                }
        }
}

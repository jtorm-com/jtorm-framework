->ui {
    c: 'WebPageElement';

    section->swap {
        s: 'header';
        ui: '@e.header';
        a: '1';

        body > header {
            ->attrs {
                n: 'class,id';
                v: 'schema-WPHeader,header';
                m: 'a';
            }

            ->attr {
                n: 'class';
                v: 'schema-WebPageElement ';
                m: 'r';
            }
        }

        #header > .contents > header->swap {
            s: 'section';
            ui: '@e.section';
            a: 1;
        }

        #header > .contents > footer->swap {
            s: 'section';
            ui: '@e.section';
            a: 1;
        }
    }
}
// Scoped data copies preserve caller/frozen input and reset the internal label.
->data(
    price: price,
    priceCurrency: priceCurrency,
    availability: availability,
    url: url
)
->data(availabilityLabel: '')
->ui {
    c: '@e.div';
    t: '0';

    div {
        ->attr {
            n: 'class';
            v: 'offer';
        }

        ->data(html: price)
        ->append
        ->ui {
            c: '@e.span';

            span {
                ->attr {
                    n: 'class';
                    v: 'price';
                }

                ->prepend {
                    t: ' ';
                }
            }
        }

        ->if(d: priceCurrency)
        ->data(html: ' ' + priceCurrency)
        ->append
        ->ui {
            c: '@e.span';

            span->attr {
                n: 'class';
                v: 'price-currency';
            }
        }

        ->if(d: availability, v: '[\x0A\x0D\u2028\u2029]', r: true) {
            ->else {
                ->if(d: availability, v: '^https?://schema[.]org/(InStock|OutOfStock|BackOrder|Discontinued|InStoreOnly|LimitedAvailability|MadeToOrder|OnlineOnly|PreOrder|PreSale|Reserved|SoldOut)$', r: true) {
                    ->if(d: availability, v: '/InStock')->text {
                        availabilityLabel: 'In stock';
                    }

                    ->if(d: availability, v: '/OutOfStock')->text {
                        availabilityLabel: 'Out of stock';
                    }

                    ->if(d: availability, v: '/BackOrder')->text {
                        availabilityLabel: 'Back order';
                    }

                    ->if(d: availability, v: '/Discontinued')->text {
                        availabilityLabel: 'Discontinued';
                    }

                    ->if(d: availability, v: '/InStoreOnly')->text {
                        availabilityLabel: 'In-store only';
                    }

                    ->if(d: availability, v: '/LimitedAvailability')->text {
                        availabilityLabel: 'Limited availability';
                    }

                    ->if(d: availability, v: '/MadeToOrder')->text {
                        availabilityLabel: 'Made to order';
                    }

                    ->if(d: availability, v: '/OnlineOnly')->text {
                        availabilityLabel: 'Online only';
                    }

                    ->if(d: availability, v: '/PreOrder')->text {
                        availabilityLabel: 'Pre-order';
                    }

                    ->if(d: availability, v: '/PreSale')->text {
                        availabilityLabel: 'Pre-sale';
                    }

                    ->if(d: availability, v: '/Reserved')->text {
                        availabilityLabel: 'Reserved';
                    }

                    ->if(d: availability, v: '/SoldOut')->text {
                        availabilityLabel: 'Sold out';
                    }
                }
            }
        }

        ->data(html: availabilityLabel || availability)
        ->append
        ->ui {
            c: '@e.span';

            span {
                ->attr {
                    n: 'class';
                    v: 'availability';
                }

                ->prepend {
                    t: ' ';
                }
            }
        }

        ->if(d: url)
        ->data(href: url)
        ->text(html: 'Offer')
        ->append
        ->ui {
            c: '@e.a';

            a {
                ->attr {
                    n: 'class';
                    v: 'offer-url';
                }

                ->prepend {
                    t: ' ';
                }
            }
        }
    }
}

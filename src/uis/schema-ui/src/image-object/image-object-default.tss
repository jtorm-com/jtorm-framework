->if(to: 'array') {
    ->each
    ->get(d: @id)
    ->get(d: size.@id, a: 'size')
    ->get(d: size.additionalProperty.@id, a: 'size.additionalProperty')
    ->if(d: size.additionalProperty.value) {
        ->get(d: width.@id, a: 'width')
        ->get(d: height.@id, a: 'height')
        ->data(
            srcset: contentUrl,
            media: size.additionalProperty.value,
            width: width.value,
            height: height.value
        )
        ->ui {
            c: '@m.source';
        }

        ->else
        ->get {
            t: '@s/image-object/figure-default.tss';
        }
    }

    ->if {
        el: 'source';

        source
            ->move {
                l: 'picture';
                m: 'prepend';
            }
    }

    ->else
    ->get {
        t: '@s/image-object/figure-default.tss';
    }
}

->if(d: ImageObject, to: 'array') {
    ->each(d: ImageObject, m: 'append')
    ->if(d: size.additionalProperty.value) {
        ->data(
            srcset: contentUrl,
            media: size.additionalProperty.value,
            width: width.value,
            height: height.value
        )
        ->ui {
            c: '@m.source';
        }

        ->else
        ->if(d: representativeOfPage)
        ->get {
            t: '@s/image-object/figure-default.tss';
        }
    }

    source->move {
        l: 'picture';
        m: 'prepend';
    }

    ->else
    ->append(d: ImageObject)
    ->get {
        t: '@s/image-object/figure-default.tss';
    }
}

->text(placeholder: 'Search')
->if(d: target) {
    ->data(
        action: target.urlTemplate || target,
        target: false,
        method: 'get'
    )
    ->ui {
        c: '@f.form';

        form {
            ->attr {
                n: 'class';
                v: 'search-action';
                m: 'a';
            }

            ->data(
                name: 'query',
                value: query,
                required: '1',
                placeholder: placeholder + '...'
            )
            ->append
            ->ui {
                c: '@f.inputSearch';
            }

            ->data(
                html: placeholder,
                type: 'submit'
            )
            ->append
            ->ui {
                c: 'button.primaryButton';
            }
        }
    }

    ->else {
        ->ui {
            c: 'Action';

            .action->attr {
                n: 'class';
                v: 'search-action';
                m: 'a';
            }
        }
    }
}

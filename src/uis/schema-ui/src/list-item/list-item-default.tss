->ui {
    c: '@t.li';
    t: '0';

    li {
        ->attr {
            n: 'value';
            v: position;
        }

        ->if(d: item) {
            ->append(d: item)
            ->ui {
                c: 'Thing.item';
            }

            ->else
            ->if(
                d: @type,
                v: '^(?!ListItem$).+',
                r: true
            )
            ->append
            ->ui {
                c: 'Thing.item';
            }
        }
    }
}

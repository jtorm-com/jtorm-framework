body > section->swap {
    s: 'footer';
    ui: '@e.footer';
    a: 1;

    body > footer {
        ->attr {
            n: 'class';
            v: 'schema-WPFooter';
            m: 'a';
        }

        ->attr {
            n: 'class';
            v: 'schema-WebPageElement ';
            m: 'r';
        }
    }

    body > footer > header->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;
    }

    body > footer > footer->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;
    }
}

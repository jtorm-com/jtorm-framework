body > section->swap {
    s: 'footer';
    ui: '@e.footer';
    a: 1;

    body > footer {
        ->attrs {
            n: 'class,id';
            v: 'schema-WPFooter,footer';
            m: 'a';
        }

        ->attr {
            n: 'class';
            v: 'schema-WebPageElement ';
            m: 'r';
        }
    }

    body > footer > header->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;
    }

    body > footer > footer->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;

        body > footer > .footer->append->ui {
            c: 'grid.oneColumn';

            .cell {
                ->attr {
                    n: 'class';
                    v: 'copyright';
                    m: 'a';
                }

                ->append->ui {
                    c: '@t.small';

                    small {
                        ->append {
                            h: copyrightYear.Number + ' ' + copyrightNotice.Text;
                        }
                    }
                }
            }
        }
    }
}

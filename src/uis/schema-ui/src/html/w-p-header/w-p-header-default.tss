body > section->swap {
    s: 'header';
    ui: '@e.header';
    a: 1;

    body > header {
        ->attr {
            n: 'class';
            v: 'schema-WPHeader';
            m: 'a';
        }

        ->attr {
            n: 'class';
            v: 'schema-WebPageElement ';
            m: 'r';
        }
    }

    body > header > header->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;
    }

    body > header > footer->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;
    }
}
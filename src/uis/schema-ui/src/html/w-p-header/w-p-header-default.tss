body > section->swap {
    s: 'header';
    ui: '@e.header';
    a: 1;

    body > header {
        ->attrs {
            n: 'class,id';
            v: 'schema-WPHeader,header';
            m: 'a';
        }

        ->attr {
            n: 'class';
            v: 'schema-WebPageElement ';
            m: 'r';
        }
    }

    #header > .contents > header->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;
    }

    #header > .contents > footer->swap {
        s: 'section';
        ui: '@e.section';
        a: 1;
    }
}

->layer {
    c: '1';
    z: '1';
    e: 'after';
    t: 'iteration';

    #header h1->append->ui {
        c: '@e.span';

        span {
            ->attr {
                n: 'class';
                v: 'layer-1';
            }

            ->inner {
                h: 'Layer 1';
            }
        }
    }
}

->layer {
    c: '1';
    z: '2';
    e: 'after';
    t: 'iteration';

    #header h1 {
        ->append(cid: 'WPHeader-2', cs: 'global')->ui {// op deze manier kan je toch cachen in een layer
            c: '@e.span';

            span {
                ->attr {
                    n: 'class';
                    v: 'layer-2';
                }

                ->inner {
                    h: 'Layer 2';
                }
            }
        }

        ->append {
            h: ' user name';
        }
    }
}

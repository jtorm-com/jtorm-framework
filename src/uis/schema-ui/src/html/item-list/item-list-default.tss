->ui {
  c: '@t.ol';
  t: 0;
  ol->each {
    d: itemListElement;
    m: 'append';
    ->ui {
      c: '@t.li';
      t: 0;
      li->append(d: ListItem.item.Thing)->ui {
        c: '@e.a';
        t: 0;
        a {
          ->attr {
            n: 'href';
            v: url.URL;
          }
          /*->attr {// kan html zijn
            n: 'title';
            v: disambiguatingDescription.Text;
          }*/
          ->append->ui {
            c: '@e.span';
            t: 0;
            span->inner(d: item.Thing) {
              h: name.Text;
            }
          }
        }
      }
    }
  }
}
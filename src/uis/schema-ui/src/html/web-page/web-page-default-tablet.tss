body {
  ->append(d: hasPart.WPHeader, cid: 'WPHeader', cs: 'global')->ui {
    c: 'WPHeader';
  }

  ->append(d: breadcrumb.BreadcrumbList, cid: 'BreadcrumbList', cs: 'global')->ui {
    c: 'BreadcrumbList';
  }


// todo if mediaquery moeten hier denk ik op hoogste niveau? tablet/mobiel/desktop
// denk dat die queries een stap hoger meer relevant zijn? material etc

  ->append(d: mainEntity.@c, cid: 'mainEntity', cs: identifier.Text)->ui {
    c: '@e.main';
    main->append->ui {
        c: 'grid.oneColumn';
        .cell->append->ui {
            c: '@e.div';
            t: 0;
            div {
              ->attrs {
                n: 'id,class';
                v: 'content,content';
              }

              #content->append->ui {
                c: @type + '.default';
              }
            }
          }
        }
      }
    }
  }

  ->append(d: hasPart.WPFooter, cid: 'WPFooter', cs: 'global')->ui {
    c: 'WPFooter';
  }

  ->append(cid: 'loading', cs: 'global')->ui {
    c: 'loading';
  }
}

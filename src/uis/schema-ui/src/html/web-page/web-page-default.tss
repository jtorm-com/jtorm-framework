/*->get { oud
  t: '@c/html.tss';
}*/

head {
    ->append(cid: 'head-global', cs: 'global')->get {
        t: '@c/head-global.tss';
    }

    ->append(cid: 'head-id', cs: identifier.Text)->get {
        t: '@c/head-id.tss';
    }
}

body {

  ->append(d: hasPart.WPHeader, cid: 'WPHeader', cs: 'global')->ui {
    c: 'WPHeader';
  }

  ->append(d: breadcrumb.BreadcrumbList, cid: 'BreadcrumbList', cs: 'global')->ui {
    c: 'BreadcrumbList';
  }


// if mediaquery moeten hier denk ik op hoogste niveau? tablet/mobiel/desktop
// denk dat die queries een stap hoger meer relevant zijn? material etc

  ->append(d: mainEntity.@c, cid: 'mainEntity', cs: identifier.Text)->ui {
    c: '@e.main';
    main->append->ui {
      c: 'grid.container';
      .container->append->ui {
        c: 'grid.oneColumn';
        .first {
          ->append->ui {
            c: '@e.div';
            t: 0;
            div {
              ->attrs {
                n: 'id,class';
                v: 'content,content';
              }

              #content->append->ui {
                c: @type + '.default';
              }
            }
          }
        }
      }
    }
  }

  ->append(d: hasPart.WPFooter, cid: 'WPFooter', cs: 'global')->ui {
    c: 'WPFooter';
  }

  ->append(cid: 'loading', cs: 'global')->ui {
    c: 'loading';
  }
}

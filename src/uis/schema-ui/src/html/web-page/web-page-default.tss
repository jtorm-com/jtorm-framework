->ui {
    c: 'WebPage.init';
}

// default stuff such as header, footer etc

->mt(t: 'desktop') {
    ->ui {
        c: 'WebPage.defaultDesktop';
    }

    ->mt(t: 'desktopS') {
        ->ui {
            c: 'WebPage.defaultDesktopS';
        }
    }

    ->mt(t: 'desktopM') {
        ->ui {
            c: 'WebPage.defaultDesktopM';
        }
    }

    ->mt(t: 'desktopL') {
        ->ui {
            c: 'WebPage.defaultDesktopL';
        }
    }
}

->mt(t: 'tablet') {
    ->ui {
        c: 'WebPage.defaultTablet';
    }

    ->mt(t: 'tabletS') {
        ->ui {
            c: 'WebPage.defaultTabletS';
        }
    }

    ->mt(t: 'tabletM') {
        ->ui {
            c: 'WebPage.defaultTabletM';
        }
    }

    ->mt(t: 'tabletL') {
        ->ui {
            c: 'WebPage.defaultTabletL';
        }
    }
}

->mt(t: 'mobile') {
    ->ui {
        c: 'WebPage.defaultMobile';
    }

    ->mt(t: 'mobileS') {
        ->ui {
            c: 'WebPage.defaultMobileS';
        }
    }

    ->mt(t: 'mobileM') {
        ->ui {
            c: 'WebPage.defaultMobileM';
        }
    }

    ->mt(t: 'mobileL') {
        ->ui {
            c: 'WebPage.defaultMobileL';
        }
    }
}
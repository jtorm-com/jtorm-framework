->get {
  t: '@c/html.tss';
}

head {
    ->append(cid: 'head-default', cs: 'global')->ui {
        c: 'head.default';
    }

    ->append(cid: 'head-id', cs: identifier.Text)->ui {
        c: 'head.id';
    }
}

body {
/*
    ->append(d: hasPart.WPHeader, cid: 'WPHeader', cs: 'global')->ui {
        c: 'WPHeader.default';
        m: '1';
    }
*/
    ->append(d: hasPart.SiteNavigationElement, cid: 'SiteNavigationElement', cs: 'global')->ui {
        c: 'SiteNavigationElement.default';
        m: '1';
    }

    ->append(d: breadcrumb.BreadcrumbList, cid: 'BreadcrumbList', cs: 'global')->ui {
        c: 'BreadcrumbList.default';
        m: '1';
    }

    ->append(d: mainEntity.@c, cid: 'mainEntity', cs: identifier.Text)->ui {
        c: '@e.main';

        main->append->ui {
            c: 'grid.oneColumn';

            .cell->append->ui {
                c: '@e.div';
                t: '0';

                div {
                    ->attrs {
                        n: 'id,class';
                        v: 'content,content';
                    }

                    #content->append->ui {
                        c: @type + '.default';
                        m: '1';
                    }
                }
            }
        }
    }
/*
    ->append(d: hasPart.WPFooter, cid: 'WPFooter', cs: 'global')->ui {
        c: 'WPFooter.default';
        m: '1';
    }
*/
    ->append(cid: 'loading', cs: 'global')->ui {
        c: 'loading.default';
        m: '1';
    }
}

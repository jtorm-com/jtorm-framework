->ui {
    c: '@e.nav';

    nav->append->ui {
        c: 'contents.default';

        .contents->append(d: hasPart)->ui {
            c: '@t.ol';
            t: '0';

            ol->each(m: 'append')->ui {
                c: '@t.li';
                t: '0';

                li->append(d: @c)->ui {
                    c: @type + '.link';
                }
            }
        }
    }
}

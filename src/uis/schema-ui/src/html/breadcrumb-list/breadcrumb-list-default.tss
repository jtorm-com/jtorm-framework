->ui {
    c: '@e.nav';
    t: 0;

    nav {
        ->attrs {
            n: 'id,class,aria-label,role';
            v: 'breadcrumbs,breadcrumb,Breadcrumb,navigation';
        }

        ->append->ui {
            c: 'grid.oneColumn';

            .cell {
                ->text(html: 'You are here')->append->ui {
                    c: '@e.span';
                    t: 0;

                    span->append {
                        h: html + ': ';
                    }
                }

                ->append->ui {
                    c: 'ItemList';
                }
            }
        }
    }
}
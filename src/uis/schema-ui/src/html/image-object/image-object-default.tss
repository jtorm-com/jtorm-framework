->if(to: 'array') {
    ->each {
        m: 'append';

        ->if(d: ImageObject) {
            ->if(d: ImageObject.representativeOfPage.Boolean) {
                ->append(d: ImageObject)->ui {
                    c: 'ImageObject.figure';
                }

                ->else {
                    ->data(
                        srcset: ImageObject.contentUrl.URL,
                        media: ImageObject.size.QuantitativeValue.additionalProperty.PropertyValue.value.Text,
                        width: ImageObject.width.QuantitativeValue.value.Number,
                        height: ImageObject.height.QuantitativeValue.value.Number
                    )->append()->ui {
                        c: '@m.source';
                    }
                }
            }
        }
    }

    source->move {
        l: 'picture';
        m: 'prepend';
    }

    ->else {
        ->if(d: ImageObject) {
            ->append(d: ImageObject)->ui {
                c: 'ImageObject.figure';
            }

            ->else->data(contentUrl.URL: URL)->append->ui {
                c: 'ImageObject.figure';
            }
        }
    }
}

->ui {
    c: '@m.figure';
    t: '0';

    figure {
        ->append->ui {
            c: 'ImageObject.picture';
        }

        ->if(d: caption.Text)->data(html: caption.Text)->append->ui {
            c: '@m.figcaption';
        }
    }
}

->ui {
    c: '@e.main'

    main {
        ->attr {
            n: 'id';
            v: 'body';
        }

        #body->append->ui {
            c: '@e.div';
            t: '0';

            div {
                ->attrs {
                    n: 'id';
                    v: 'contents';
                }

                #contents->append->ui {
                    c: @type + '.default';
                    m: '1';
                }
            }
        }
    }
}
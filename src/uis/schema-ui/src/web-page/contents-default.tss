->ui {
    c: '@e.main';

    main {
        ->attr {
            n: 'id';
            v: 'body';
        }

        #body
            ->append
            ->ui {
                c: '@e.div';
                t: '0';

                div {
                    ->attr {
                        n: 'id';
                        v: 'contents';
                    }

                    #contents
                        ->config(d: @type + '.' + identifier + '.template', a: '@template')
                        ->data(@template: @template || 'default')
                        ->append
                        ->ui {
                            c: @type + '.' + @template;
                            m: '1';
                        }
                }
            }
    }
}

->title {
    t: name;
}

html {
    ->config(
        d: 'dir',
        a: 'dir'
    )
    ->attr {
        n: 'dir';
        v: dir;
    }

    ->attr {
        n: 'lang';
        v: inLanguage;
    }
}

head {
    ->append(
        l: inLanguage,
        cid: 'head',
        cs: 'default'
    )
    ->ui {
        c: 'head.default';
    }

    ->append(
        l: inLanguage,
        cid: 'head',
        cs: identifier
    )
    ->ui {
        c: 'head.id';
    }
}

body {
    ->each {
        d: hasPart;

        // sort order is important this way, but takes less code
        ->if(
            d: @type,
            v: '^WPHeader|SiteNavigationElement',
            r: true
        )
        ->get(d: @id)
        ->append(
            l: inLanguage,
            cid: @type,
            cs: identifier
        )
        ->ui {
            c: @type;
        }
    }

    ->if(d: breadcrumb)
    ->get(d: breadcrumb.@id)
    ->append(
        l: inLanguage,
        cid: 'BreadcrumbList',
        cs: breadcrumb.identifier
    )
    ->ui {
        c: 'BreadcrumbList';
    }

    ->append(
        d: mainEntityOfPage,
        l: inLanguage,
        cid: 'mainEntityOfPage',
        cs: identifier
    )
    ->get(d: @id)
    ->ui {
        c: 'WebPage.contents';
    }

    ->append(
        d: mainEntity,
        l: inLanguage,
        cid: 'mainEntity',
        cs: identifier
    )
    ->get(d: @id)
    ->ui {
        c: 'WebPage.contents';
    }

    ->each {
        d: hasPart;

        ->if(
            d: @type,
            v: '^WPFooter',
            r: true
        )
        ->get(d: @id)
        ->append(
            l: inLanguage,
            cid: @type,
            cs: identifier
        )
        ->ui {
            c: @type;
        }
    }

    ->append(
        l: inLanguage,
        cid: 'loading',
        cs: 'default'
    )
    ->ui {
        c: 'loading.default';
        m: '1';
    }
}

->ui {
    c: '@e.nav';
    t: '0';

    nav {
        ->attrs {
            n: 'id,aria-label';
            v: 'primary-navigation,Primary';
        }

        ->append
        ->ui {
            c: 'contents.default';

            .contents {
                ->append
                ->each(d: potentialAction)
                ->get(d: @id) {
                    body
                        ->append
                        ->ui {
                            c: 'Action.default';
                        }
                }

                ->append
                ->ui {
                    c: '@t.ol';
                    t: '0';

                    ol
                        ->each(d: hasPart)
                        ->get(d: @id) {
                            body
                                ->append
                                ->ui {
                                    c: '@t.li';
                                    t: '0';

                                    li
                                        ->append
                                        ->ui {
                                            c: @type + '.link';
                                        }
                                }
                        }
                }
            }
        }
    }
}

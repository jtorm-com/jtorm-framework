->ui {
    c: '@e.nav';

    nav {
        ->attrs {
            n: 'id,aria-label';
            v: 'primary-navigation,Primary';
        }

        ->append->ui {
            c: 'contents.default';

            .contents {
                ->append(d: potentialAction)
                ->ui {
                    c: 'Action.linkMulti';
                }

                ->append(d: hasPart)
                ->ui {
                    c: '@t.ol';
                    t: '0';

                    ol
                        ->each
                        ->ui {
                            c: '@t.li';
                            t: '0';

                            li
                                ->append(d: @c)
                                ->ui {
                                    c: @type + '.link';
                                }
                        }
                }
            }
        }
    }
}

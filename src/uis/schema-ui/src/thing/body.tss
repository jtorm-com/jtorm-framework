->ui {
    c: '@e.section';
    t: '0';

    section->attr {
        n: 'class';
        v: 'body';
    }

    .body {
        ->if(d: disambiguatingDescription && description) {
            ->append->ui {
                c: '@e.details';
                t: '0';

                details {
                    ->attr {
                        n: 'open';
                        v: true;
                    }

                    ->append(d: disambiguatingDescription)->ui {
                        c: '@e.summary';
                        t: '0';

                        summary->append->get {
                            t: '@s/html/thing/disambiguating-description.tss';
                        }
                    }

                    ->append(d: description)->get {
                        t: '@s/html/thing/description.tss';
                    }
                }
            }

            ->else {
                ->append(d: disambiguatingDescription)->get {
                    t: '@s/html/thing/disambiguating-description.tss';

                    span->swap {
                        s: 'div';
                        a: 1;
                        ui: '@e.div';
                    }
                }

                ->append(d: description)->get {
                    t: '@s/html/thing/description.tss';
                }
            }
        }
    }
}

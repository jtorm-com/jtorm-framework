->ui {
    c: '@t.ol';
    t: '0';

    ol
        ->each(d: itemListElement)
        ->append
        ->ui {
            c: '@t.li';
            t: '0';

            li
                ->append(d: item)
                ->ui {
                    c: '@e.a';
                    t: '0';

                    a {
                        ->attr {
                            n: 'href';
                            v: url;
                        }

                        ->append
                        ->ui {
                            c: '@e.span';
                            t: '0';

                            span
                                ->inner(d: item) {
                                    h: name;
                                }
                        }
                    }
                }
        }
}

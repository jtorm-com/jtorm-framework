->ui {
    c: 'Thing.contents';

    body > .contents > .body {
        ->before(d: associatedMedia)
        ->ui {
          c: 'ImageObject';
        }

        ->if(d: hasPart)
        ->append
        ->each(d: hasPart)
        ->get(d: @id) {
            body
                ->append(
                    l: inLanguage,
                    cid: @type,
                    cs: identifier
                )
                ->ui {
                    c: @type;
                }
        }
    }

